# Local: use a Postgres URL (Docker or Railway). Railway injects DATABASE_URL automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"
PORT=8790
HOST=0.0.0.0
NODE_ENV=development
COOKIE_SECRET="change-me"
SESSION_TTL_HOURS=168
TRUSTID_API=http://localhost:8787
CORS_ORIGINS=http://localhost:5174,http://localhost:5180
TOKEN_NETWORK_PROVIDER=mock
EXPERIENCE_TOKEN_TTL_SECONDS=300
