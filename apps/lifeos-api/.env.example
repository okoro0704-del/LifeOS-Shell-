# Local: use a Postgres URL (Docker or Railway). Railway injects DATABASE_URL automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"
PORT=8790
HOST=0.0.0.0
NODE_ENV=development
COOKIE_SECRET="change-me"
SESSION_TTL_HOURS=168
TRUSTID_API=http://localhost:8787
# TRUSTID_CLIENT_ID=lifeos_mock_public
# ZK_VERIFY_MODE=hybrid
# ZK_REQUIRE_CLAIMS=false
# ZK_DEV_RELAXED=true
CORS_ORIGINS=http://localhost:5174,http://localhost:5180
TOKEN_NETWORK_PROVIDER=unbound
# Sovereign nodes bind via apps/lifeos-api/src/container.ts (DataZone / FinProv / ElfCom)
# ElfCom Phase A — set MODE=http when elfcom-node is running (default port 8791)
# ELFCOM_MODE=http
# ELFCOM_BASE_URL=http://localhost:8791
# ELFCOM_NODE_SECRET=elfcom-dev-node-secret-change-me
# Phase F — 6-primitive container (local stubs | remote HTTP engines)
# PRIMITIVES_MODE=local
# PRIMITIVES_MODE=remote
# TRUSTID_URL=http://localhost:8787
# ELFCOM_URL=http://localhost:8791
# SOVEREIGN_DRIVE_URL=http://localhost:8792
# JOBS_ENGINE_URL=http://localhost:8793
# DISTRIBUTOR_URL=http://localhost:8794
# FUNDZMAN_URL=http://localhost:8795
EXPERIENCE_TOKEN_TTL_SECONDS=300
# EXPERIENCE_TOKEN_PRIVATE_KEY=
# EXPERIENCE_TOKEN_PUBLIC_KEY=
# EXPERIENCE_TOKEN_KID=lifeos-key-2026-01
