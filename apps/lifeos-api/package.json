{
  "name": "@lifeos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "node --env-file=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --env-file=.env --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@lifeos/experience-sdk": "*",
    "@lifeos/shared": "*",
    "@lifeos/token-network": "*",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "jose": "^6.2.7",
    "prisma": "^6.5.0",
    "snarkjs": "^0.7.6",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
